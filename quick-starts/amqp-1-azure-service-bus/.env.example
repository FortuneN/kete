# Azure Service Bus Configuration
# Copy this file to .env and fill in your values

# Your Service Bus namespace name (without .servicebus.windows.net)
SERVICEBUS_NAMESPACE=your-namespace

# Shared Access Signature key name (usually RootManageSharedAccessKey)
SERVICEBUS_SAS_KEY_NAME=RootManageSharedAccessKey

# Shared Access Signature key value
SERVICEBUS_SAS_KEY=your-sas-key-here
