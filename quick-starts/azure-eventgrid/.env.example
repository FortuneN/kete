# Azure Event Grid Configuration
# Copy this file to .env and fill in your values

# Your Event Grid topic endpoint URL
# Example: https://keycloak-events-topic.eastus-1.eventgrid.azure.net/api/events
EVENTGRID_ENDPOINT=https://your-topic.region-1.eventgrid.azure.net/api/events

# Your Event Grid topic access key (Azure Portal > Event Grid Topic > Access keys)
EVENTGRID_KEY=your-access-key-here
