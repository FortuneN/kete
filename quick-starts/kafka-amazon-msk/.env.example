# Amazon MSK Configuration
# Copy this file to .env and fill in your values

# Bootstrap servers (comma-separated broker endpoints with port)
# Example: b-1.mycluster.abc123.c2.kafka.us-east-1.amazonaws.com:9096,b-2.mycluster.abc123.c2.kafka.us-east-1.amazonaws.com:9096
MSK_BOOTSTRAP_SERVERS=broker-1:9096,broker-2:9096

# SASL/SCRAM credentials (stored in AWS Secrets Manager)
MSK_USERNAME=your-username
MSK_PASSWORD=your-password
