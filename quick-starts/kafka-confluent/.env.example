# Confluent Cloud Configuration
# Copy this file to .env and fill in your values

# Your Confluent Cloud bootstrap server
# Example: pkc-xxxxx.us-east-1.aws.confluent.cloud:9092
CONFLUENT_BOOTSTRAP_SERVER=your-cluster.confluent.cloud:9092

# Your Confluent Cloud API key
CONFLUENT_API_KEY=your-api-key

# Your Confluent Cloud API secret
CONFLUENT_API_SECRET=your-api-secret
