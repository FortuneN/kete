# Azure Web PubSub Configuration
# Copy this file to .env and fill in your values

# Your Azure Web PubSub connection string
# Find it in Azure Portal > Web PubSub Service > Keys > Connection string
AZURE_WEBPUBSUB_CONNECTION_STRING=Endpoint=https://your-webpubsub.webpubsub.azure.com;AccessKey=your-access-key;Version=1.0;
