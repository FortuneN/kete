# Amazon ElastiCache for Redis (Pub/Sub) Configuration
# Copy this file to .env and fill in your values

# Your ElastiCache primary endpoint
# Example: my-cluster.abc123.0001.use1.cache.amazonaws.com
ELASTICACHE_HOST=your-cluster.cache.amazonaws.com

# AUTH token (if encryption in transit is enabled)
ELASTICACHE_AUTH_TOKEN=your-auth-token
