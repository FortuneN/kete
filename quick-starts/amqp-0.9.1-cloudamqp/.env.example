# CloudAMQP Configuration
# Copy this file to .env and fill in your values

# Your CloudAMQP hostname
# Example: sparrow-01.rmq.cloudamqp.com
CLOUDAMQP_HOST=your-instance.rmq.cloudamqp.com

# Username (same as your vhost on shared instances)
CLOUDAMQP_USERNAME=your-username

# Password
CLOUDAMQP_PASSWORD=your-password

# Virtual host (same as username on shared instances)
CLOUDAMQP_VHOST=your-vhost
