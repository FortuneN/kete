# Amazon MQ (ActiveMQ - AMQP 1.0) Configuration
# Copy this file to .env and fill in your values

# Your Amazon MQ broker endpoint (without protocol prefix)
# Example: b-1234abcd-5678-efgh-9012-ijklmnopqrst-1.mq.us-east-1.amazonaws.com
AMAZONMQ_HOST=your-broker-id.mq.your-region.amazonaws.com

# Broker credentials (set during broker creation)
AMAZONMQ_USERNAME=your-username
AMAZONMQ_PASSWORD=your-password
