	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.13.0</version>
				<configuration>
					<release>21</release>
					<annotationProcessorPaths>
						<path>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
							<version>1.18.42</version>
						</path>
					</annotationProcessorPaths>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-enforcer-plugin</artifactId>
				<version>3.6.2</version>
				<executions>
					<execution>
						<goals>
							<goal>enforce</goal>
						</goals>
						<configuration>
							<rules>
								<requireMavenVersion>
									<version>3.9.0</version>
								</requireMavenVersion>
								<requireJavaVersion>
									<version>[21,)</version>
									<message>Java 21 or higher is required. Current version: ${java.version}</message>
								</requireJavaVersion>
							</rules>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<version>3.5.4</version>
				<configuration>
					<argLine>@{argLine} -XX:+EnableDynamicAgentLoading -Dnet.bytebuddy.experimental=true</argLine>
					<systemPropertyVariables>
						<keycloak.version>${keycloak.version}</keycloak.version>
					</systemPropertyVariables>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<version>0.8.13</version>
				<executions>
					<execution>
						<id>prepare-agent</id>
						<goals>
							<goal>prepare-agent</goal>
						</goals>
					</execution>
					<execution>
						<id>report</id>
						<phase>test</phase>
						<goals>
							<goal>report</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-shade-plugin</artifactId>
				<version>3.6.1</version>
				<executions>
					<execution>
						<phase>package</phase>
						<goals>
							<goal>shade</goal>
						</goals>
						<configuration>
							<finalName>kete</finalName>
							<shadedArtifactAttached>false</shadedArtifactAttached>
							<dependencyReducedPomLocation>${project.build.directory}/dependency-reduced-pom.xml</dependencyReducedPomLocation>
							<filters>
								<filter>
									<artifact>*:*</artifact>
									<excludes>
										<exclude>module-info.class</exclude>
										<exclude>META-INF/versions/*/module-info.class</exclude>
										<exclude>META-INF/*.SF</exclude>
										<exclude>META-INF/*.DSA</exclude>
										<exclude>META-INF/*.RSA</exclude>
										<exclude>META-INF/maven/**</exclude>
										<exclude>META-INF/MANIFEST.MF</exclude>
										<exclude>about.html</exclude>
										<exclude>bundle.properties</exclude>
										<exclude>COPYRIGHT.txt</exclude>
										<exclude>LICENSE.txt</exclude>
										<exclude>META-INF/DEPENDENCIES</exclude>
									</excludes>
								</filter>
							</filters>
							<!--
							=============================================================================
							CRITICAL: DEPENDENCY SHADING RELOCATIONS
							=============================================================================

							WHY WE NEED THIS:
							Keycloak bundles many libraries internally (Jackson, Netty, Guava, SLF4J,
							Apache Commons, etc.) and different Keycloak versions use different library
							versions. Without shading, we get runtime conflicts:

							  WITHOUT SHADING → NoSuchMethodError, ClassNotFoundException, version conflicts
							  WITH SHADING    → Extension works across Keycloak 25.x, 26.x+ without recompilation

							CRITICAL OVERLAPS WITH KEYCLOAK:
							- Jackson Core/Annotations: Keycloak provides 2.17.0, we need jackson-core
							- SLF4J: Keycloak provides this transitively, many of our deps require it
							- Netty: Keycloak may bundle 4.1.127, qpid-jms brings 4.1.108
							- Guava: Potential conflicts with Keycloak's bundled version
							- Kotlin stdlib: From OkHttp dependencies, potential conflicts

							RULE:
							Every dependency without <scope>provided</scope> or <scope>test</scope>
							MUST be relocated to avoid classpath conflicts when loaded into Keycloak.

							All packages relocated under: io.github.fortunen.kete.shaded.*
							=============================================================================
							-->
							<relocations>
								<!-- Jackson (Keycloak bundles jackson-databind, we must shade all jackson packages) -->
								<relocation>
									<pattern>com.fasterxml.jackson.core</pattern>
									<shadedPattern>io.github.fortunen.kete.shaded.jackson.core</shadedPattern>
								</relocation>
								<relocation>
									<pattern>com.fasterxml.jackson.annotation</pattern>
									<shadedPattern>io.github.fortunen.kete.shaded.jackson.annotation</shadedPattern>
								</relocation>
								<relocation>
									<pattern>com.fasterxml.jackson.databind</pattern>
									<shadedPattern>io.github.fortunen.kete.shaded.jackson.databind</shadedPattern>
								</relocation>
								<!-- Jackson dataformats -->
								<relocation>
									<pattern>com.fasterxml.jackson.dataformat.xml</pattern>
									<shadedPattern>io.github.fortunen.kete.shaded.jackson.dataformat.xml</shadedPattern>
								</relocation>
								<relocation>
									<pattern>com.fasterxml.jackson.dataformat.yaml</pattern>
									<shadedPattern>io.github.fortunen.kete.shaded.jackson.dataformat.yaml</shadedPattern>
								</relocation>
								<relocation>
									<pattern>com.fasterxml.jackson.dataformat.csv</pattern>
									<shadedPattern>io.github.fortunen.kete.shaded.jackson.dataformat.csv</shadedPattern>
								</relocation>
								<relocation>
									<pattern>com.fasterxml.jackson.dataformat.toml</pattern>
									<shadedPattern>io.github.fortunen.kete.shaded.jackson.dataformat.toml</shadedPattern>
								</relocation>
								<relocation>
									<pattern>com.fasterxml.jackson.dataformat.smile</pattern>
									<shadedPattern>io.github.fortunen.kete.shaded.jackson.dataformat.smile</shadedPattern>
								</relocation>
								<relocation>
									<pattern>com.fasterxml.jackson.dataformat.cbor</pattern>
									<shadedPattern>io.github.fortunen.kete.shaded.jackson.dataformat.cbor</shadedPattern>
								</relocation>
								<relocation>
									<pattern>com.fasterxml.jackson.dataformat.javaprop</pattern>
									<shadedPattern>io.github.fortunen.kete.shaded.jackson.dataformat.javaprop</shadedPattern>
								</relocation>
								<!-- Kafka -->
								<relocation>
									<pattern>org.apache.kafka</pattern>
									<shadedPattern>io.github.fortunen.kete.shaded.kafka</shadedPattern>
								</relocation>
								<!-- SLF4J (Keycloak provides this, but many of our deps require it) -->
								<relocation>
									<pattern>org.slf4j</pattern>
									<shadedPattern>io.github.fortunen.kete.shaded.slf4j</shadedPattern>
								</relocation>
								<!-- Netty (Keycloak bundles netty, qpid-jms brings 4.1.108, Keycloak may use different version) -->
								<relocation>
									<pattern>io.netty</pattern>
									<shadedPattern>io.github.fortunen.kete.shaded.netty</shadedPattern>
								</relocation>
								<!-- Kotlin stdlib (okhttp brings this, conflicts possible) -->
								<relocation>
									<pattern>kotlin</pattern>
									<shadedPattern>io.github.fortunen.kete.shaded.kotlin</shadedPattern>
								</relocation>
								<relocation>
									<pattern>org.jetbrains.kotlin</pattern>
									<shadedPattern>io.github.fortunen.kete.shaded.jetbrains.kotlin</shadedPattern>
								</relocation>
								<!-- RabbitMQ AMQP client -->
								<relocation>
									<pattern>com.rabbitmq</pattern>
									<shadedPattern>io.github.fortunen.kete.shaded.rabbitmq</shadedPattern>
								</relocation>
								<!-- Apache Commons -->
								<relocation>
									<pattern>org.apache.commons.lang3</pattern>
									<shadedPattern>io.github.fortunen.kete.shaded.commons.lang3</shadedPattern>
								</relocation>
								<relocation>
									<pattern>org.apache.commons.io</pattern>
									<shadedPattern>io.github.fortunen.kete.shaded.commons.io</shadedPattern>
								</relocation>
								<relocation>
									<pattern>org.apache.commons.text</pattern>
									<shadedPattern>io.github.fortunen.kete.shaded.commons.text</shadedPattern>
								</relocation>
								<relocation>
									<pattern>org.apache.commons.configuration2</pattern>
									<shadedPattern>io.github.fortunen.kete.shaded.commons.configuration2</shadedPattern>
								</relocation>
								<relocation>
									<pattern>org.apache.commons.pool2</pattern>
									<shadedPattern>io.github.fortunen.kete.shaded.commons.pool2</shadedPattern>
								</relocation>
								<!-- Glob matcher -->
								<relocation>
									<pattern>com.hrakaroo.glob</pattern>
									<shadedPattern>io.github.fortunen.kete.shaded.glob</shadedPattern>
								</relocation>
								<!-- Reflections -->
								<relocation>
									<pattern>org.reflections</pattern>
									<shadedPattern>io.github.fortunen.kete.shaded.reflections</shadedPattern>
								</relocation>
								<!-- Resilience4j -->
								<relocation>
									<pattern>io.github.resilience4j</pattern>
									<shadedPattern>io.github.fortunen.kete.shaded.resilience4j</shadedPattern>
								</relocation>
								<!-- Nimbus OAuth SDK -->
								<relocation>
									<pattern>com.nimbusds</pattern>
									<shadedPattern>io.github.fortunen.kete.shaded.nimbusds</shadedPattern>
								</relocation>
								<!-- Eclipse Paho MQTT -->
								<relocation>
									<pattern>org.eclipse.paho.client.mqttv3</pattern>
									<shadedPattern>io.github.fortunen.kete.shaded.paho.mqttv3</shadedPattern>
								</relocation>
								<relocation>
									<pattern>org.eclipse.paho.mqttv5</pattern>
									<shadedPattern>io.github.fortunen.kete.shaded.paho.mqttv5</shadedPattern>
								</relocation>
								<!-- Apache Qpid JMS (AMQP 1.0) -->
								<relocation>
									<pattern>org.apache.qpid</pattern>
									<shadedPattern>io.github.fortunen.kete.shaded.qpid</shadedPattern>
								</relocation>
								<!-- Java-WebSocket -->
