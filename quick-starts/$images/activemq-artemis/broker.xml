<?xml version='1.0'?>
<!--
  Minimal broker.xml override for STOMP prefix routing.

  CRITICAL: The STOMP acceptor needs anycastPrefix=/queue/ and multicastPrefix=/topic/
  otherwise messages sent to "/queue/xxx" create MULTICAST addresses instead of ANYCAST queues.
  See: https://stackoverflow.com/questions/68895552/stomp-sending-to-queue-but-arriving-as-topic-on-artemis

  This file is merged with the default broker.xml via etc-override.
-->
<configuration xmlns="urn:activemq" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="urn:activemq /schema/artemis-configuration.xsd">

   <core xmlns="urn:activemq:core">

      <name>0.0.0.0</name>

      <acceptors>
         <acceptor name="amqp">tcp://0.0.0.0:5672?protocols=AMQP</acceptor>
         <acceptor name="artemis">tcp://0.0.0.0:61616?protocols=CORE,AMQP,HORNETQ,MQTT,OPENWIRE</acceptor>
         <acceptor name="stomp">tcp://0.0.0.0:61613?protocols=STOMP;anycastPrefix=/queue/;multicastPrefix=/topic/</acceptor>
      </acceptors>

      <security-settings>
         <security-setting match="#">
            <permission type="send" roles="amq"/>
            <permission type="manage" roles="amq"/>
            <permission type="browse" roles="amq"/>
            <permission type="consume" roles="amq"/>
            <permission type="createAddress" roles="amq"/>
            <permission type="deleteAddress" roles="amq"/>
            <permission type="deleteDurableQueue" roles="amq"/>
            <permission type="createDurableQueue" roles="amq"/>
            <permission type="createNonDurableQueue" roles="amq"/>
            <permission type="deleteNonDurableQueue" roles="amq"/>
         </security-setting>
      </security-settings>

      <address-settings>
         <address-setting match="#">
            <auto-create-queues>true</auto-create-queues>
            <auto-create-addresses>true</auto-create-addresses>
         </address-setting>
      </address-settings>

   </core>

</configuration>
