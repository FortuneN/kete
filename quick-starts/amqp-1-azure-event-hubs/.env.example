# Azure Event Hubs (AMQP) Configuration
# Copy this file to .env and fill in your values

# Your Event Hubs namespace name (without .servicebus.windows.net)
EVENTHUB_NAMESPACE=your-namespace

# Shared Access Signature key name (usually RootManageSharedAccessKey)
EVENTHUB_SAS_KEY_NAME=RootManageSharedAccessKey

# Shared Access Signature key value
EVENTHUB_SAS_KEY=your-sas-key-here
