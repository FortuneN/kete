# Azure Event Grid (HTTP) Configuration
# Copy this file to .env and fill in your values

# Your Event Grid topic endpoint URL
# Example: https://your-topic.eastus-1.eventgrid.azure.net/api/events
EVENTGRID_ENDPOINT=https://your-topic.region.eventgrid.azure.net/api/events

# Your Event Grid topic access key
EVENTGRID_KEY=your-access-key-here
