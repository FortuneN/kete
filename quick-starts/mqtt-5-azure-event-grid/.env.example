# Azure Event Grid (MQTT) Configuration
# Copy this file to .env and fill in your values

# Your Event Grid MQTT hostname
# Example: your-namespace.westus2-1.ts.eventgrid.azure.net
EVENTGRID_MQTT_HOST=your-namespace.region.ts.eventgrid.azure.net

# Note: You also need to generate X.509 certificates
# See GUIDE.md for certificate generation instructions
# Place your client.pem file in the ./certs/ directory
