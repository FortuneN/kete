# GCP Cloud Tasks Configuration
# Copy this file to .env and fill in your values

# Your GCP project ID
GCP_PROJECT_ID=your-project-id

# GCP location (region) where your queue is created
GCP_LOCATION=us-central1

# The URL that Cloud Tasks will invoke when dispatching tasks
GCP_TARGET_URL=https://your-service.example.com/handler

# Base64-encoded service account JSON key
# Generate with: [Convert]::ToBase64String([IO.File]::ReadAllBytes("service-account.json"))
GCP_SA_KEY_BASE64=your-base64-encoded-service-account-json
